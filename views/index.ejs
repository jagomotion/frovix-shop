<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 py-5 flex-1 w-full space-y-5">
  <!-- Bar Pencarian & Filter Cepat (Pengganti kartu metrik) -->
  <div class="bg-white p-3.5 rounded-2xl border border-neutral-200/80 shadow-xs space-y-3">
    <div class="flex items-center gap-2">
      <div class="relative flex-1">
        <i data-lucide="search" class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input 
          type="text" 
          id="search-input" 
          onkeyup="filterProducts()" 
          placeholder="Cari script, bot, tools digital..." 
          class="w-full pl-9 pr-3 py-2 text-xs bg-neutral-50 rounded-xl border border-neutral-200 focus:outline-none focus:border-neutral-900 transition"
        >
      </div>
      <button 
        id="btn-verified-only" 
        onclick="toggleVerifiedFilter()" 
        class="px-3 py-2 border border-neutral-200 rounded-xl text-xs font-semibold text-neutral-600 hover:bg-neutral-50 transition flex items-center gap-1.5 shrink-0"
        title="Filter hanya toko centang biru"
      >
        <i data-lucide="badge-check" class="w-3.5 h-3.5 text-sky-500 fill-sky-500 text-white"></i>
        <span class="hidden sm:inline">Terverifikasi</span>
      </button>
    </div>

    <!-- Kategori Tabs Interaktif -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-[11px] font-semibold no-scrollbar">
      <button onclick="setCategory('all')" class="cat-btn px-3 py-1.5 rounded-lg bg-neutral-900 text-white shrink-0 transition" data-cat="all">Semua</button>
      <button onclick="setCategory('Web Scripts')" class="cat-btn px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-600 hover:bg-neutral-200 shrink-0 transition" data-cat="Web Scripts">Web Scripts</button>
      <button onclick="setCategory('Tools & Bot')" class="cat-btn px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-600 hover:bg-neutral-200 shrink-0 transition" data-cat="Tools & Bot">Tools & Bot</button>
      <button onclick="setCategory('Templates')" class="cat-btn px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-600 hover:bg-neutral-200 shrink-0 transition" data-cat="Templates">Templates</button>
      <button onclick="setCategory('Digital Assets')" class="cat-btn px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-600 hover:bg-neutral-200 shrink-0 transition" data-cat="Digital Assets">Asset Digital</button>
    </div>
  </div>

  <!-- SKELETON SHIMMER LOADER -->
  <div id="product-skeleton" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
    <% for(let i=0; i<8; i++) { %>
      <div class="bg-white rounded-2xl border border-neutral-200/70 p-3 space-y-3">
        <div class="w-full aspect-video rounded-xl shimmer"></div>
        <div class="h-3.5 w-3/4 rounded shimmer"></div>
        <div class="h-3 w-1/2 rounded shimmer"></div>
        <div class="h-6 w-1/3 rounded-lg shimmer"></div>
      </div>
    <% } %>
  </div>

  <!-- GRID PRODUK DENGAN CENTANG BIRU JELAS & AKSI CEPAT -->
  <div id="product-grid" class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
    <% if (products.length === 0) { %>
      <div class="col-span-full py-16 text-center space-y-2">
        <div class="w-10 h-10 rounded-full bg-neutral-100 text-neutral-400 flex items-center justify-center mx-auto">
          <i data-lucide="package-open" class="w-5 h-5"></i>
        </div>
        <p class="text-xs text-neutral-400 font-medium">Belum ada produk yang disetujui</p>
      </div>
    <% } %>

    <% products.forEach(prod => { %>
      <div 
        class="product-card bg-white rounded-2xl border border-neutral-200/80 overflow-hidden hover:border-neutral-400 transition flex flex-col justify-between group shadow-xs hover:shadow"
        data-title="<%= prod.title.toLowerCase() %>"
        data-category="<%= prod.category %>"
        data-verified="<%= prod.is_verified ? 'true' : 'false' %>"
      >
        <div>
          <!-- Thumbnail & Badge Diskon -->
          <a href="/product/<%= prod.id %>" class="block relative aspect-video w-full bg-neutral-100 overflow-hidden">
            <img src="<%= prod.thumbnail %>" alt="<%= prod.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
            
            <% if (prod.discount_price) { %>
              <% const discountPercent = Math.round(((prod.price - prod.discount_price) / prod.price) * 100); %>
              <span class="absolute top-2 left-2 bg-red-600 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded shadow-xs">
                -<%= discountPercent %>%
              </span>
            <% } %>

            <span class="absolute top-2 right-2 bg-white/90 backdrop-blur-xs text-neutral-700 text-[9px] font-semibold px-1.5 py-0.5 rounded border border-neutral-200/60">
              <%= prod.category %>
            </span>
          </a>

          <!-- Konten Produk -->
          <div class="p-3">
            <!-- Nama Seller & Badge Centang Biru -->
            <a href="/store/<%= prod.seller_username %>" class="flex items-center gap-1.5 group/seller mb-1">
              <img src="<%= prod.shop_avatar %>" class="w-4 h-4 rounded-full object-cover">
              <span class="text-[11px] font-semibold text-neutral-700 truncate group-hover/seller:text-neutral-900 max-w-[130px]">
                <%= prod.shop_name %>
              </span>
              <% if (prod.is_verified) { %>
                <i data-lucide="badge-check" class="w-3.5 h-3.5 text-sky-500 fill-sky-500 text-white shrink-0" title="Toko Terverifikasi Resmi"></i>
              <% } %>
            </a>

            <!-- Judul Produk -->
            <a href="/product/<%= prod.id %>">
              <h3 class="font-semibold text-xs text-neutral-900 line-clamp-2 leading-snug group-hover:text-neutral-700 transition">
                <%= prod.title %>
              </h3>
            </a>

            <!-- Rating & Skor Bintang -->
            <div class="flex items-center gap-1.5 text-[11px] text-neutral-500 mt-2">
              <i data-lucide="star" class="w-3 h-3 text-amber-500 fill-amber-500"></i>
              <span class="font-bold text-neutral-800"><%= prod.product_rating %></span>
              <span class="text-[10px] text-neutral-400">(<%= prod.product_reviews_count %> ulasan)</span>
            </div>

            <!-- Harga & Diskon -->
            <div class="flex items-baseline gap-1.5 mt-2">
              <span class="text-sm font-extrabold text-neutral-900">
                Rp <%= (prod.discount_price || prod.price).toLocaleString() %>
              </span>
              <% if (prod.discount_price) { %>
                <span class="text-[10px] text-neutral-400 line-through">
                  Rp <%= prod.price.toLocaleString() %>
                </span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Tombol Aksi Cepat Bawah -->
        <div class="p-2.5 bg-neutral-50/80 border-t border-neutral-100 flex items-center justify-between gap-1.5">
          <a 
            href="/chat/store/<%= prod.seller_id %>?productId=<%= prod.id %>" 
            class="p-2 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-200/60 rounded-lg transition" 
            title="Tanya Penjual"
          >
            <i data-lucide="message-circle" class="w-4 h-4"></i>
          </a>

          <button 
            onclick="copyLink('<%= prod.id %>')" 
            class="p-2 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-200/60 rounded-lg transition" 
            title="Salin Tautan Produk"
          >
            <i data-lucide="share-2" class="w-4 h-4"></i>
          </button>

          <a 
            href="/product/<%= prod.id %>" 
            class="flex-1 py-1.5 px-3 bg-neutral-900 hover:bg-neutral-800 text-white rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition"
          >
            <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
            <span>Beli</span>
          </a>
        </div>
      </div>
    <% }) %>
  </div>

  <div id="no-filter-results" class="hidden py-16 text-center text-xs text-neutral-400">
    Tidak ada produk yang cocok dengan pencarian atau filter Anda.
  </div>
</main>

<!-- Notifikasi Toast Ringkas Saat Salin Tautan -->
<div id="toast" class="fixed bottom-6 right-6 z-50 bg-neutral-900 text-white text-xs px-3.5 py-2 rounded-xl shadow-lg transform translate-y-12 opacity-0 transition-all duration-200 flex items-center gap-2">
  <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i>
  <span>Tautan disalin ke papan klip</span>
</div>

<script>
  let activeCategory = 'all';
  let filterVerifiedOnly = false;

  // Hilangkan Skeleton setelah DOM siap
  window.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      document.getElementById('product-skeleton').classList.add('hidden');
      document.getElementById('product-grid').classList.remove('hidden');
      lucide.createIcons();
    }, 250);
  });

  // Filter Kategori
  function setCategory(cat) {
    activeCategory = cat;
    document.querySelectorAll('.cat-btn').forEach(b => {
      if (b.dataset.cat === cat) {
        b.className = 'cat-btn px-3 py-1.5 rounded-lg bg-neutral-900 text-white shrink-0 transition';
      } else {
        b.className = 'cat-btn px-3 py-1.5 rounded-lg bg-neutral-100 text-neutral-600 hover:bg-neutral-200 shrink-0 transition';
      }
    });
    filterProducts();
  }

  // Filter Toko Terverifikasi Saja
  function toggleVerifiedFilter() {
    filterVerifiedOnly = !filterVerifiedOnly;
    const btn = document.getElementById('btn-verified-only');
    if (filterVerifiedOnly) {
      btn.className = 'px-3 py-2 bg-sky-50 border border-sky-300 rounded-xl text-xs font-bold text-sky-700 transition flex items-center gap-1.5 shrink-0 shadow-xs';
    } else {
      btn.className = 'px-3 py-2 border border-neutral-200 rounded-xl text-xs font-semibold text-neutral-600 hover:bg-neutral-50 transition flex items-center gap-1.5 shrink-0';
    }
    filterProducts();
  }

  // Filter Real-Time
  function filterProducts() {
    const query = document.getElementById('search-input').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.product-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const title = card.dataset.title;
      const category = card.dataset.category;
      const isVerified = card.dataset.verified === 'true';

      const matchesSearch = title.includes(query);
      const matchesCat = activeCategory === 'all' || category === activeCategory;
      const matchesVerified = !filterVerifiedOnly || isVerified;

      if (matchesSearch && matchesCat && matchesVerified) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const noResults = document.getElementById('no-filter-results');
    if (visibleCount === 0 && cards.length > 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  // Salin Tautan Produk
  function copyLink(productId) {
    const url = `${window.location.origin}/product/${productId}`;
    navigator.clipboard.writeText(url).then(() => {
      const toast = document.getElementById('toast');
      toast.classList.remove('translate-y-12', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-12', 'opacity-0');
      }, 2000);
    });
  }
</script>

<%- include('partials/footer') %>
