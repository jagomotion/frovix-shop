<%- include('partials/header') %>
<main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
  <h2 class="text-xl font-bold mb-4">Daftar Laporan Penipuan dari Buyer</h2>
  <div class="space-y-4">
    <% if (reports.length === 0) { %>
      <p class="text-xs text-neutral-400">Belum ada laporan masuk.</p>
    <% } %>
    <% reports.forEach(r => { %>
      <div class="bg-white p-4 rounded-xl border border-red-200">
        <div class="flex justify-between items-start">
          <div>
            <span class="text-[10px] bg-red-100 text-red-700 px-2 py-0.5 rounded font-bold">Laporan Scam/Rusak</span>
            <h4 class="font-bold text-sm mt-1">Produk: <%= r.product.title || 'ID: ' + r.product_id %></h4>
            <p class="text-xs text-neutral-500">Seller: <%= r.seller.shop_name %> (@<%= r.seller.username %>)</p>
          </div>
          <span class="text-[10px] text-neutral-400"><%= new Date(r.created_at).toLocaleString('id-ID') %></span>
        </div>
        <p class="text-xs text-neutral-700 bg-neutral-50 p-2.5 rounded-lg border mt-2">"<%= r.reason %>"</p>
        <p class="text-[10px] text-neutral-400 mt-2">Pelapor: <%= r.buyer_name %> (<%= r.buyer_contact %>)</p>
      </div>
    <% }) %>
  </div>
</main>
<%- include('partials/footer') %>