<%- include('partials/header') %>
<main class="max-w-xl mx-auto px-4 py-6 flex-1 w-full space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-neutral-100 flex items-center justify-center text-neutral-800">
        <i data-lucide="message-square" class="w-4 h-4"></i>
      </div>
      <h1 class="text-sm font-bold text-neutral-900">Kotak Pesan</h1>
    </div>
    <span class="text-xs text-neutral-400 font-medium"><%= contacts.length %> kontak</span>
  </div>

  <div class="bg-white rounded-2xl border border-neutral-200/80 overflow-hidden shadow-xs">
    <% if (contacts.length === 0) { %>
      <div class="py-16 text-center space-y-2">
        <div class="w-10 h-10 rounded-full bg-neutral-100 text-neutral-400 flex items-center justify-center mx-auto">
          <i data-lucide="messages-square" class="w-5 h-5"></i>
        </div>
        <p class="text-xs text-neutral-400 font-medium">Belum ada percakapan</p>
        <a href="/" class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-900 hover:underline pt-1">
          <i data-lucide="compass" class="w-3.5 h-3.5"></i>
          <span>Jelajahi Produk</span>
        </a>
      </div>
    <% } else { %>
      <div class="divide-y divide-neutral-100">
        <% contacts.forEach(contact => { %>
          <a href="/chat/store/<%= contact.id %>" class="p-3.5 flex items-center justify-between hover:bg-neutral-50/80 transition group">
            <div class="flex items-center gap-3">
              <div class="relative">
                <img src="<%= contact.avatar || '/uploads/avatars/default.png' %>" class="w-10 h-10 rounded-full object-cover border border-neutral-200/50">
                <% if (contact.is_verified) { %>
                  <div class="absolute -bottom-0.5 -right-0.5 bg-sky-500 text-white p-0.5 rounded-full border border-white">
                    <i data-lucide="check" class="w-2.5 h-2.5 stroke-[3]"></i>
                  </div>
                <% } %>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <p class="text-xs font-bold text-neutral-900 group-hover:text-neutral-700">
                    <%= contact.shop_name || contact.username %>
                  </p>
                  <% if (contact.is_verified) { %>
                    <i data-lucide="badge-check" class="w-3.5 h-3.5 text-sky-500 fill-sky-500 text-white shrink-0"></i>
                  <% } %>
                </div>
                <p class="text-[11px] text-neutral-400">@<%= contact.username %></p>
              </div>
            </div>
            <div class="p-1.5 rounded-lg text-neutral-400 group-hover:text-neutral-900 group-hover:bg-neutral-100 transition">
              <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
