<%- include('partials/header') %>
<main class="max-w-md mx-auto px-4 py-10 flex-1 w-full">
  <div class="bg-white p-6 rounded-2xl border border-neutral-200/90 text-center space-y-5 shadow-xs">
    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto">
      <i data-lucide="check" class="w-6 h-6 stroke-[3]"></i>
    </div>
    
    <div>
      <h2 class="text-base font-bold">Berhasil</h2>
      <p class="text-[11px] text-neutral-400 mt-0.5">Tautan dikirim ke <%= order.buyer_email %></p>
    </div>

    <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-100 flex items-center justify-between">
      <div class="text-left truncate max-w-[190px]">
        <p class="text-xs font-semibold truncate"><%= product.title %></p>
        <p class="text-[10px] text-neutral-400">Siap unduh</p>
      </div>
      <a href="/download/<%= order.order_id %>" class="bg-neutral-900 text-white px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1 hover:bg-neutral-800 transition">
        <i data-lucide="download" class="w-3.5 h-3.5"></i>
        <span>Unduh</span>
      </a>
    </div>

    <!-- Rating SVG Stars (Bukan Emoji) -->
    <div class="border-t border-neutral-100 pt-4 text-left">
      <p class="text-xs font-bold mb-2">Beri Ulasan</p>
      <form action="/product/<%= product.id %>/review" method="POST" class="space-y-2.5">
        <input type="hidden" name="buyer_name" value="<%= order.buyer_name %>">
        <div>
          <label class="text-[10px] text-neutral-400 uppercase font-semibold">Skor Penilaian</label>
          <select name="rating" class="w-full border rounded-lg p-2 text-xs mt-1 focus:outline-none">
            <option value="5">5 Bintang (Sangat Baik)</option>
            <option value="4">4 Bintang (Baik)</option>
            <option value="3">3 Bintang (Cukup)</option>
            <option value="2">2 Bintang (Kurang)</option>
            <option value="1">1 Bintang (Buruk)</option>
          </select>
        </div>
        <textarea name="comment" rows="2" placeholder="Catatan singkat..." class="w-full border rounded-lg p-2 text-xs focus:outline-none"></textarea>
        <button type="submit" class="w-full bg-neutral-100 hover:bg-neutral-200 text-neutral-800 py-2 rounded-lg text-xs font-semibold transition flex items-center justify-center gap-1">
          <i data-lucide="send" class="w-3.5 h-3.5"></i>
          <span>Kirim</span>
        </button>
      </form>
    </div>
  </div>
</main>
<%- include('partials/footer') %>