<%- include('partials/header') %>
<main class="max-w-sm mx-auto px-4 py-16 flex-1 w-full">
  <div class="bg-white p-6 rounded-2xl border border-neutral-200">
    <h2 class="text-xl font-bold mb-4">Masuk Toko Seller</h2>
    <form action="/seller/login" method="POST" class="space-y-3">
      <div>
        <label class="text-xs font-medium">Username / Email</label>
        <input type="text" name="username" required class="w-full border rounded-lg p-2 text-sm mt-1">
      </div>
      <div>
        <label class="text-xs font-medium">Password</label>
        <input type="password" name="password" required class="w-full border rounded-lg p-2 text-sm mt-1">
      </div>
      <button type="submit" class="w-full bg-neutral-900 text-white py-2.5 rounded-lg text-sm font-semibold">Masuk</button>
    </form>
    <p class="text-xs text-center text-neutral-400 mt-4">Belum punya toko? <a href="/seller/register" class="text-neutral-900 font-semibold">Daftar</a></p>
  </div>
</main>
<%- include('partials/footer') %>